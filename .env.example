APP_NAME=UpileStore
ENVIRONMENT=development

# PostgreSQL: postgresql://usuario:senha@host:5432/nome_do_banco
# Exemplo Railway / Render / Supabase: postgresql://postgres:senha@monorail.proxy.rlwy.net:5432/railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upilestore

JWT_SECRET_KEY=change-me-to-a-very-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000,https://upile-store-moz.vercel.app
